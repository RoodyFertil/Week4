classDiagram
    %% Final design: matches pawpal_system.py
    note "Entry = a (Pet, Task) pair. Tasks do not store their pet, so the Scheduler passes pairs around."

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Pet
        +get_all_tasks() list~Entry~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +replace_task(old: Task, new: Task) None
        +task_count() int
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +start_minutes int
        +end_minutes int
        +end_time str
        +priority_rank int
        +mark_complete() Task?
        +next_occurrence() Task?
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Entry~
        +sort_by_time(entries)$ list~Entry~
        +filter_tasks(pet_name, completed, due_on) list~Entry~
        +tasks_due(day) list~Entry~
        +detect_conflicts(entries)$ list~str~
        +mark_task_complete(pet_name, task) Task?
        +build_daily_plan(day) DailyPlan
    }

    class DailyPlan {
        +date day
        +list~PlanItem~ scheduled
        +list~PlanItem~ skipped
        +list~str~ conflicts
        +int minutes_available
        +minutes_used int
        +explain() str
    }

    class PlanItem {
        +Pet pet
        +Task task
        +str reason
    }

    Owner "1" o-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : owns
    Scheduler --> Owner : reads pets/tasks via
    Scheduler ..> DailyPlan : builds
    DailyPlan "1" *-- "0..*" PlanItem : contains
    PlanItem --> Pet
    PlanItem --> Task
    Task ..> Task : next_occurrence() creates
